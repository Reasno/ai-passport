# 妹妹设备构建覆盖项示例。复制为 sdkconfig.defaults.sister 后填入真实姓名（该文件已被忽略）。
# 构建命令：
#   idf.py -B build_sister -D SDKCONFIG=sdkconfig.sister \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.sister" build
CONFIG_KIDS_ACTOR_BROTHER=n
CONFIG_KIDS_ACTOR_SISTER=y
CONFIG_ACTOR_CHILD_ID="sister"

CONFIG_KP_CHILD_NAME="小朋友"
CONFIG_KP_CHILD_ROLE="妹妹"
