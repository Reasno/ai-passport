menu "Kids Points 固件"

config WIFI_SSID
    string "Wi-Fi SSID"
    default "YOUR_WIFI_SSID_HERE"

config WIFI_PASSWORD
    string "Wi-Fi password"
    default "YOUR_WIFI_PASSWORD_HERE"

config MQTT_BROKER_HOST
    string "MQTT broker host"
    default "192.168.31.111"

config MQTT_BROKER_PORT
    int "MQTT broker port"
    range 1 65535
    default 1883

choice KIDS_ACTOR
    prompt "绑定孩子"
    default KIDS_ACTOR_BROTHER
config KIDS_ACTOR_BROTHER
    bool "brother（哥哥）"
config KIDS_ACTOR_SISTER
    bool "sister（妹妹）"
endchoice

config ACTOR_CHILD_ID
    string
    default "brother" if KIDS_ACTOR_BROTHER
    default "sister" if KIDS_ACTOR_SISTER

config KP_CHILD_NAME
    string "Home 页面显示的孩子姓名"
    default "小朋友"
    help
        仅用于本机 Home 页面显示。请在已忽略的 sdkconfig.defaults 中配置真实姓名，
        不要将孩子真实姓名提交到源码或 sdkconfig.defaults.example。

config KP_CHILD_ROLE
    string "Home 页面显示的孩子角色"
    default "小朋友"
    help
        仅用于本机 Home 页面显示，例如哥哥或妹妹。

config KIDS_DEVICE_ID
    string "本机互动设备 ID"
    default "ai_passport_brother" if KIDS_ACTOR_BROTHER
    default "ai_passport_sister" if KIDS_ACTOR_SISTER
    help
        本机身份，服务端按 ai_passport_<child_id> 校验，必须保持该命名。

config KIDS_PEER_DEVICE_ID
    string "伙伴互动设备 ID"
    default "ai_passport_sister" if KIDS_ACTOR_BROTHER
    default "ai_passport_brother" if KIDS_ACTOR_SISTER
    help
        Find 按键响铃的目标设备 ID。

config KP_PEER_LABEL
    string
    default "妹妹" if KIDS_ACTOR_BROTHER
    default "哥哥" if KIDS_ACTOR_SISTER
    help
        互动页面对伙伴的称呼，跟随 KIDS_ACTOR 自动切换：哥哥的设备找妹妹，妹妹的设备找哥哥。

config KIDS_USE_OFFICIAL_AVATAR
    bool "Use built-in official avatar artwork"
    default y
    help
        Show the checked-in RGB565A8 brother/sister artwork directly from flash.
        Disable only to use the small vector fallback avatar.

config ENABLE_SCREENSHOT
    bool "Enable USB Serial/JTAG screenshot command"
    default n
    help
        Debug-only SCREENSHOT command. It streams LVGL's existing 20-row flush
        chunks as RGB565LE and never allocates a full-screen framebuffer.

config KIDS_THEME_SISTER
    bool
    default y if KIDS_ACTOR_SISTER

endmenu
